function save_data(s)
    local data, json
    data = { fa_status = s }
    json = Ark_HS:JSONEncode(data)
    writefile("Lappland.Arknight", json, true)
end

function read_data()
    local success, data = pcall(readfile, "Lappland.Arknight")
    if success then
        local de_coded = Ark_HS:JSONDecode(data)
        return de_coded.fa_status
    else
        return "Auto Attacking [OFF]"
    end
end

pcall(function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/HoangHien2k3/Arknight/refs/heads/Source/BladeHits"))()
    print("Successfully Loaded: Distance Auto Attack")
end)

Ark_UI.MouseButton1Click:Connect(function()
    if ArkUI_State then
        ArkUI_State = false
        Ark_Ability_Fr.Visible = false
        Ark_UI.Text = "Target Enemies[OFF]"
    else
        ArkUI_State = true
        Ark_Ability_Fr.Visible = true
        Ark_UI.Text = "Target Enemies[ON]"
    end
end)

fa_status = read_data()
Ark_FastAttack_UI.Text = fa_status

Ark_FastAttack_UI.MouseButton1Click:Connect(function()
    if Ark_FastAttack_UI.Text == "Auto Attacking [OFF]" then
        save_data("Auto Attacking [ON]")
        Ark_FastAttack_UI.Text = "Auto Attacking [ON]"
        Ark_FastAttack_UI.TextColor3 = ArkC_Red
        _G.Attack_Play = true
    else
        save_data("Auto Attacking [OFF]")
        Ark_FastAttack_UI.Text = "Auto Attacking [OFF]"
        Ark_FastAttack_UI.TextColor3 = ArkC_White
        _G.Attack_Play = false
    end
end)

Ark_FastAttack_Delay_UI.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local new_delay = tonumber(Ark_FastAttack_Delay_UI.Text)
        _G.Attack_Delay = new_delay
    end
end)

